    "dsh-safe-web-fetch": "https://github.com/Apoze/dsh-safe-web-fetch/releases/download/v0.1.0-next.1/dsh-safe-web-fetch-0.1.0-next.1.tgz",
    "jsdom": "30.0.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/dsh-web": "0.2.1-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/dsh-web": "0.2.1-rc.3"
  },
  "files": [
    "index.js",
    "readability.js",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
