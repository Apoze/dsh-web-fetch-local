{
  "name": "dsh-web-fetch-local",
  "version": "0.2.3",
  "private": true,
  "description": "Secure local Readability provider for the DeepSeek Harness web_fetch tool",
  "license": "MIT",
  "repository": "github:Apoze/dsh-web-fetch-local",
  "homepage": "https://github.com/Apoze/dsh-web-fetch-local#readme",
  "bugs": "https://github.com/Apoze/dsh-web-fetch-local/issues",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "web-fetch",
    "readability",
    "ssrf"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
